# Backend environment. Copy to apps/api/.env. Never commit .env.
PORT=3000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Supabase project URL and the server-side secret key (Project Settings > API Keys).
# The secret key bypasses Row Level Security. It must never reach the browser.
SUPABASE_URL=https://cppbznpjwfkszmjfkdnz.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Database access: the API uses the Supabase client with the secret key (no database password needed).

# UCC CampusSphere - overview of every variable. Placeholders only, never real secrets.
# Real values go in apps/api/.env and apps/web/.env (both git-ignored).
# The per-app templates are apps/api/.env.example and apps/web/.env.example.

# ---- Backend only (apps/api/.env). Never expose these to the browser. ----
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SUPABASE_URL=https://cppbznpjwfkszmjfkdnz.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ---- Public site (apps/web/.env). No sign-in and no keys. ----
VITE_API_URL=

# ---- Admin site (apps/admin/.env). Bundled into the browser, so public values only. ----
# VITE_API_URL is the same address as above (empty in development).
VITE_SUPABASE_URL=https://cppbznpjwfkszmjfkdnz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_PUBLIC_SITE_URL=http://localhost:5173
